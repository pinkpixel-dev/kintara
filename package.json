{
  "name": "kintara",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors magenta,cyan --kill-others \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd apps/server && cargo run",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "cd apps/server && cargo test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
