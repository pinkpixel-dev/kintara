{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kintara",
  "version": "0.1.0",
  "identifier": "dev.pinkpixel.kintara",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/library/thumbnails/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A premium document organizer and reader",
    "longDescription": "Kintara is a premium document organizer and reader application built with Tauri, React, and Vite. It offers frictionless interaction with knowledge, prioritizing a distraction-free, highly polished dark/light UI.",
    "copyright": "Copyright © 2026 Pink Pixel"
  }
}
