# Your library and its database.
#
# docker-compose.yml mounts ./kintara-data as /data, so running compose from
# docker/ creates a directory holding the SQLite database, the session table,
# and every generated thumbnail. That must never end up in the repository.
docker/kintara-data/
/data/
*.db
*.db-shm
*.db-wal

